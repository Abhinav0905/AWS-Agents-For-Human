# local = SQLite + stdio MCP simulator; aws = same code on AgentCore Runtime (see docs/DEPLOY.md)
POSTSCRIPT_MODE=local
# scripted = deterministic offline clerk (no model calls); bedrock = Claude on Amazon Bedrock via Strands BedrockModel
POSTSCRIPT_MODEL=scripted
# Cross-region inference profile or model id enabled in your account, e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0
POSTSCRIPT_MODEL_ID=
AWS_REGION=us-west-2
POSTSCRIPT_DATA_DIR=.postscript
POSTSCRIPT_ESTATE_DIR=data/estate_alvarez
POSTSCRIPT_SIM_SEED=7
# none | sns  (SNS needs POSTSCRIPT_SNS_TOPIC_ARN)
POSTSCRIPT_NOTIFY=none
POSTSCRIPT_SNS_TOPIC_ARN=
